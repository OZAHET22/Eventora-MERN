# ==============================================================================
# EVENTORA BACKEND CONFIGURATION
# ==============================================================================

# MongoDB Atlas Connection URI
# 1. Sign in to MongoDB Atlas (https://cloud.mongodb.com)
# 2. Click "Connect" -> "Drivers" -> Node.js
# 3. Paste the connection string here, replacing <password> with your DB user password
# 4. In Atlas -> Network Access: Add IP Address -> '0.0.0.0/0' (Allow access from anywhere)
#    (Required because Vercel Serverless Function IPs are dynamically assigned)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/eventora?retryWrites=true&w=majority

# JWT Secret Key
# Use a high-entropy secret string for signing JSON Web Tokens
JWT_SECRET=supersecretjwtkey_eventora_change_in_production

# Email Service (Nodemailer with Gmail)
# Optional in local dev: If blank, OTPs and confirmation logs will print to console.
# In Production: Create a Google App Password (not your normal Gmail password):
# Google Account -> Security -> 2-Step Verification -> App Passwords
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password

# Server Port (Used for local standalone server)
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=development
