{
  "name": "eventora-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Eventora - Production Full-Stack MERN Event Platform (Vercel Monorepo + MongoDB Atlas)",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "build": "npm run build --prefix client",
    "build:client": "npm run build --prefix client",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "start": "npm run start --prefix server",
    "start:server": "npm run start --prefix server",
    "start:client": "npm run preview --prefix client",
    "seed": "npm run seed --prefix server",
    "verify": "node verify.js",
    "lint": "npm run lint --prefix client",
    "install:all": "npm install"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.2.0",
    "nodemailer": "^6.9.11"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
